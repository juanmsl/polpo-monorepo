{
  "$schema": "https://v2-10-3.turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/apps/polpo-docs/src/stories/**",
        "$TURBO_ROOT$/packages/tailwind-config/*.css"
      ],
      "outputs": ["dist/**", "$TURBO_ROOT$/plugins/polpo/**"]
    }
  }
}
