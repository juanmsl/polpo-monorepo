{
  "$schema": "https://v2-10-13.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build-storybook": {
      "dependsOn": [
        "^build",
        "^build-storybook"
      ],
      "outputs": [
        "storybook-static/**",
        "dist/**",
        "build/**"
      ]
    },
    "postbuild": {
      "dependsOn": ["build"]
    },
    "lint": {
      "cache": true,
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
